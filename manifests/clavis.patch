new file mode 100644
index 0000000..2490bf7
--- /dev/null
+++ b/Widgets/common/RectangularShadow.qml
@@ -0,0 +1,28 @@
+import QtQuick
+
+Item {
+    id: root
+
+    property real blur: 0
+    property bool cached: false
+    property color color: "transparent"
+    property real radius: 0
+    property real spread: 0
+    property var target
+    property vector2d offset: Qt.vector2d(0, 0)
+
+    visible: opacity > 0 && color.a > 0
+    x: offset.x
+    y: offset.y
+    width: target ? target.width + 2 * spread : 0
+    height: target ? target.height + 2 * spread : 0
+    opacity: color.a
+
+    Rectangle {
+        anchors.fill: parent
+        anchors.margins: -root.spread
+        color: Qt.rgba(root.color.r, root.color.g, root.color.b, 1)
+        radius: root.radius + root.spread
+        opacity: 0.28
+    }
+}
diff --git a/scripts/theme/sync_cursor_settings.py b/scripts/theme/sync_cursor_settings.py
new file mode 100644
index 0000000..5a4c844
--- /dev/null
+++ b/scripts/theme/sync_cursor_settings.py
@@ -0,0 +1,32 @@
+#!/usr/bin/env python3
+"""Synchronize client cursor settings with the compositor's selected cursor."""
+import json
+import shutil
+import subprocess
+import sys
+
+
+def sync(theme, size):
+    size = int(size)
+    if not 12 <= size <= 128 or any(char in theme for char in '\n\r\0'):
+        raise ValueError('Invalid cursor theme or size')
+    if shutil.which('gsettings'):
+        settings = [('cursor-size', str(size))]
+        if theme:
+            settings.append(('cursor-theme', json.dumps(theme, ensure_ascii=False)))
+        for key, value in settings:
+            subprocess.run(['gsettings', 'set', 'org.gnome.desktop.interface', key, value],
+                           check=True, timeout=5)
+    if shutil.which('systemctl'):
+        values = [f'XCURSOR_SIZE={size}']
+        if theme:
+            values.append(f'XCURSOR_THEME={theme}')
+        subprocess.run(['systemctl', '--user', 'set-environment', *values], check=True, timeout=5)
+
+
+if __name__ == '__main__':
+    try:
+        sync(*sys.argv[1:])
+    except (ValueError, TypeError, OSError, subprocess.SubprocessError) as error:
+        print(error, file=sys.stderr)
+        sys.exit(1)
